{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron/reengagement", "schedule": "0 10 * * *" },
    { "path": "/api/cron/healthcheck", "schedule": "0 7 * * *" }
  ],
  "rewrites": [
    { "source": "/join", "destination": "/biostat-quest" },
    { "source": "/diagnostic", "destination": "/biostat-quest" },
    { "source": "/diagnostic/results", "destination": "/biostat-quest" },
    { "source": "/tree", "destination": "/biostat-quest" },
    { "source": "/lab", "destination": "/biostat-quest" },
    { "source": "/rlab", "destination": "/biostat-quest" },
    { "source": "/badges", "destination": "/biostat-quest" },
    { "source": "/leaderboard", "destination": "/biostat-quest" },
    { "source": "/stats", "destination": "/biostat-quest" },
    { "source": "/glossary", "destination": "/biostat-quest" },
    { "source": "/admin", "destination": "/biostat-quest" },
    { "source": "/teach", "destination": "/biostat-quest" },
    { "source": "/exam", "destination": "/biostat-quest" },
    { "source": "/competency", "destination": "/biostat-quest" },
    { "source": "/misconceptions", "destination": "/biostat-quest" },
    { "source": "/upgrade", "destination": "/biostat-quest" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
